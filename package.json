{
  "name": "nexvix-innovations",
  "version": "1.0.0",
  "type": "module",
  "description": "NEXVIX Innovations - Marketing Website (static + Cloudflare Pages Functions)",
  "scripts": {
    "build:static": "node build-static.js",
    "deploy": "npm run build:static && npx wrangler pages deploy dist --project-name nexvixinnovations",
    "preview": "npx wrangler pages dev dist --compatibility-date=2024-09-23",
    "test:email": "tsx scripts/test-email.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.2.0",
    "wrangler": "^3.114.17"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1"
  }
}
